{
  "name": "quizz-root",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "picomatch": "4.0.3"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter server build",
    "deploy:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ops/deploy-backend.ps1",
    "rollback:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ops/deploy-backend.ps1 -RollbackLatest",
    "deploy:frontend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ops/deploy-frontend.ps1",
    "rollback:frontend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ops/deploy-frontend.ps1 -RollbackLatest",
    "backup:database": "node server/scripts/backup-database.mjs",
    "start": "pnpm --filter server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3"
  }
}
